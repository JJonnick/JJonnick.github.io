---
import Content from "@/layouts/Content.astro";
import Layout from "@/layouts/Layout.astro";
import StatsList, { type StatRow } from "@/components/StatsList.astro";
import { toActivityView } from "@/games/hsr/activity";
import { loadDataset } from "@/services/dataset-loader";
import { toSafeNumber } from "@/utils/numbers";

const account = loadDataset("hsr", "account");
const activity = toActivityView(loadDataset("hsr", "activity"));

const stats = account.stats;
const nickname = account.nickname?.trim() || "Trailblazer";
const level = toSafeNumber(account.level);
const summaryRows: StatRow[] = [
    { icon: "User", value: nickname, label: "Jugador" },
    { icon: "Star", value: level, label: "Nivel" },
    { icon: "Calendar", value: toSafeNumber(stats?.active_days), label: "Días activos" },
    { icon: "Award", value: toSafeNumber(stats?.achievement_num), label: "Logros" },
    { icon: "Users", value: toSafeNumber(stats?.avatar_num), label: "Personajes" },
    { icon: "Package", value: toSafeNumber(stats?.chest_num), label: "Cofres" },
    {
        icon: "Map",
        value: toSafeNumber(stats?.dreamscape_pass_sticker),
        label: "Pegatinas del Pase Onírico",
    },
    { icon: "Shell", value: stats?.abyss_process || "-", label: "Progreso de abismo" },
];
const progressGroups = [activity.simulatedUniverse, activity.diary].filter(
    (group) => group !== null,
);
---

<Layout title="Estadísticas de Honkai: Star Rail">
    <Content>
        <h1 class="text-heading-page wrap-break-word">
            {nickname}, así va tu cuenta de Honkai: Star Rail
        </h1>
        <p class="text-muted-body mt-2 max-w-2xl">
            Revisa tu progreso general en una sola vista.
        </p>

        <StatsList rows={summaryRows} class="mt-5" />

        <section class="mt-8 space-y-3">
            <h2 class="text-heading-section">Contenido endgame</h2>
            <div class="grid gap-4 md:grid-cols-3">
                {
                    activity.endgame.map((group) => (
                        <div class="space-y-2">
                            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">
                                {group.title}
                            </h3>
                            <StatsList rows={group.rows} />
                        </div>
                    ))
                }
            </div>
        </section>

        {
            progressGroups.length > 0 && (
                <div class="mt-8 grid gap-6 md:grid-cols-2">
                    {progressGroups.map((group) => (
                        <section class="space-y-3">
                            <h2 class="text-heading-section">{group.title}</h2>
                            <StatsList rows={group.rows} />
                        </section>
                    ))}
                </div>
            )
        }
    </Content>
</Layout>
