---
import Content from "@/layouts/Content.astro";
import Layout from "@/layouts/Layout.astro";
import Stars from "@/components/Stars.astro";
import LazyImage from "@/components/LazyImage.astro";
import RowData from "@/components/RowData.astro";
import { Star } from "@lucide/astro";
import { toCharacterDetail } from "@/games/hsr/detail";
import { getHsrLocale } from "@/games/hsr/i18n";
import { loadDataset } from "@/services/dataset-loader";
import type { HsrCharacter } from "@/types";

interface Props {
    char: HsrCharacter;
}

export function getStaticPaths() {
    const characters = loadDataset("hsr", "characters");

    return characters.map((char) => ({
        params: { id: String(char.id) },
        props: { char },
    }));
}

const detail = toCharacterDetail(Astro.props.char, getHsrLocale());
const { lightCone, memosprite, labels } = detail;
---

<Layout title={detail.name}>
    <link slot="head" rel="preload" as="image" href={detail.icon} />
    <Content>
        <article class="mx-auto w-full max-w-4xl space-y-5">
            <header
                class="surface-panel flex flex-col items-center gap-3 p-5 text-center dark:text-slate-100"
            >
                <LazyImage
                    transitionName={`char-icon-${detail.id}`}
                    class="rounded-2xl bg-slate-100 p-1 ring-1 ring-slate-300 dark:bg-slate-800 dark:ring-slate-700"
                    src={detail.icon}
                    alt={`${detail.name} ${labels.avatarSuffix}`}
                    width={120}
                    height={141}
                    aspectRatioClass="aspect-[40/47]"
                    loading="eager"
                />

                <div class="flex flex-col items-center gap-1">
                    <h1
                        class="text-heading-page"
                        transition:name={`char-name-${detail.id}`}
                    >
                        {detail.name}
                    </h1>
                    <p class="text-muted-body text-sm">
                        {detail.element}
                    </p>
                </div>

                <Stars quantity={detail.rarity} />
            </header>

            <section class="surface-panel space-y-2 p-4 text-[15px]">
                <RowData
                    icon="Gauge"
                    value={detail.levelText}
                    label={labels.level}
                    variant="plain"
                />
                <RowData
                    icon="Sparkles"
                    value={`E${detail.rankText}`}
                    label={labels.eidolon}
                    variant="plain"
                />
                <RowData
                    icon="Map"
                    value={detail.path}
                    label={labels.path}
                    variant="plain"
                />
                <RowData
                    icon="Swords"
                    value={`${labels.level} ${lightCone.levelText}`}
                    label={labels.lightCone}
                    variant="plain"
                />
            </section>

            <section class="surface-panel p-4">
                <p class="text-muted-body text-sm">
                    {labels.equippedLightCone}
                </p>
                <div
                    class="mt-2 flex flex-col items-start gap-3 sm:flex-row sm:items-center"
                >
                    <LazyImage
                        class="h-14 w-14 shrink-0 rounded-lg bg-slate-100 p-1 ring-1 ring-slate-300 dark:bg-slate-800 dark:ring-slate-700"
                        src={lightCone.icon}
                        alt={`${lightCone.name} ${labels.iconSuffix}`}
                        width={56}
                        height={56}
                    />
                    <div class="min-w-0">
                        <p
                            class="text-sm font-semibold text-slate-900 dark:text-slate-100 wrap-break-word"
                        >
                            {lightCone.name}
                        </p>
                        {
                            lightCone.isEquipped && lightCone.rarity > 0 && (
                                <div
                                    class="mt-1 flex items-center gap-0.5"
                                    role="img"
                                    aria-label={labels.lightConeRarity(lightCone.rarity)}
                                >
                                    {Array.from(
                                        { length: lightCone.rarity },
                                        () => (
                                            <Star
                                                size={14}
                                                class="text-yellow-500"
                                                aria-hidden="true"
                                            />
                                        ),
                                    )}
                                </div>
                            )
                        }
                        <p class="text-muted-body text-xs">
                            {labels.level}
                            {lightCone.levelText} · {lightCone.rankText}
                        </p>
                    </div>
                </div>
            </section>

            {
                memosprite && (
                    <section class="surface-panel p-4">
                        <p class="text-muted-body text-sm">
                            {labels.memosprite}
                        </p>
                        <div class="mt-2 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
                            <LazyImage
                                class="h-12 w-12 shrink-0 rounded-lg bg-slate-100 p-1 ring-1 ring-slate-300 dark:bg-slate-800 dark:ring-slate-700"
                                src={memosprite.icon}
                                alt={`${memosprite.name} ${labels.iconSuffix}`}
                                width={48}
                                height={48}
                            />
                            <p class="min-w-0 text-sm font-semibold text-slate-900 dark:text-slate-100 wrap-break-word">
                                {memosprite.name}
                            </p>
                        </div>
                    </section>
                )
            }
        </article>
    </Content>
</Layout>
