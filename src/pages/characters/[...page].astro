---
import CharacterListPage from "@/components/CharacterListPage.astro";
import { getCharacters } from "@/services/database";
import {
    CHARACTER_PAGE_SIZE,
    collectPresentElements,
    collectRarities,
} from "@/services/character-list";
import { GENSHIN_ELEMENT_LABELS, GENSHIN_ELEMENTS, type GenshinElement } from "@/utils/elements";
import type { Character } from "@/types";
import type { GetStaticPaths, Page } from "astro";

interface Props {
    page: Page<Character>;
    allCharacters: Character[];
    presentElements: GenshinElement[];
    rarities: number[];
    elementLabels: Record<GenshinElement, string>;
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
    const allCharacters = await getCharacters();

    const presentElements = collectPresentElements(allCharacters, GENSHIN_ELEMENTS);
    const rarities = collectRarities(allCharacters);

    return paginate(allCharacters, {
        pageSize: CHARACTER_PAGE_SIZE,
        props: {
            allCharacters,
            presentElements,
            rarities,
            elementLabels: GENSHIN_ELEMENT_LABELS,
        },
    });
};

const { page, allCharacters, presentElements, rarities, elementLabels } = Astro.props;
---

<CharacterListPage
    title="Lista de personajes"
    heading="Tus personajes"
    description="Selecciona uno para ver nivel, constelación, amistad y arma."
    emptyMessage="No encontramos personajes en tus datos todavía. Actualiza el archivo e inténtalo de nuevo."
    characters={allCharacters}
    basePath="/characters"
    presentElements={presentElements}
    rarities={rarities}
    elementLabels={elementLabels}
    showElementIcons={true}
    pagination={{
        currentPage: page.currentPage,
        lastPage: page.lastPage,
        prevUrl: page.url.prev,
        nextUrl: page.url.next,
    }}
/>
