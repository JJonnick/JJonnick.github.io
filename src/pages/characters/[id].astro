---
import Content from "@/layouts/Content.astro";
import Layout from "@/layouts/Layout.astro";
import Stars from "@/components/Stars.astro";
import LazyImage from "@/components/LazyImage.astro";
import { Gauge, Sparkles, Heart, Swords } from "@lucide/astro";
import { GENSHIN_WEAPON_TYPE_LABELS } from "@/constants/genshin";
import { getCharacters } from "@/services/database";
import { type Character } from "@/types/character";
import { toSafeNumber } from "@/utils/numbers";
import { getGenshinElementIconPath } from "@/utils/elements";

interface Props {
    char: Character;
}

export async function getStaticPaths() {
    const characters = await getCharacters();

    return characters.map((char) => ({
        params: { id: String(char.id) },
        props: { char },
    }));
}

const { char } = Astro.props;
const { id, icon, name, rarity, element, level, constellation, friendship, weapon_type } = char;

const safeName = name?.trim() || "Personaje desconocido";
const safeElement = element?.trim() || "Elemento desconocido";
const safeIcon = icon || "/fallbacks/icon.svg";
const safeRarity = Math.min(5, Math.max(1, toSafeNumber(rarity) || 1));
const safeLevel = toSafeNumber(level);
const safeConstellation = toSafeNumber(constellation);
const safeFriendship = toSafeNumber(friendship);
const safeElementIcon = getGenshinElementIconPath(safeElement);
const weaponName = GENSHIN_WEAPON_TYPE_LABELS[weapon_type] ?? "Desconocido";
const statCardClass = "surface-panel p-3";
const statLabelClass = "text-muted-body text-xs";
const statValueClass = "text-lg font-semibold text-slate-900 dark:text-slate-100";
const statItems = [
    { Icon: Gauge, label: "Nivel", value: safeLevel },
    { Icon: Sparkles, label: "Constelación", value: `C${safeConstellation}` },
    { Icon: Heart, label: "Amistad", value: safeFriendship },
    { Icon: Swords, label: "Arma", value: weaponName },
] as const;
---

<Layout title={safeName}>
    <link slot="head" rel="preload" as="image" href={safeIcon} />
    <Content>
        <article class="mx-auto w-full max-w-4xl space-y-5">
            <header
                class="surface-panel flex flex-col items-center gap-3 p-5 text-center dark:text-slate-100"
            >
                <LazyImage
                    transitionName={`char-icon-${id}`}
                    class="rounded-full bg-slate-100 p-1 ring-1 ring-slate-300 dark:bg-slate-800 dark:ring-slate-700"
                    src={safeIcon}
                    alt={`${safeName} avatar`}
                    width={120}
                    height={120}
                    loading="eager"
                />

                <div class="flex items-center gap-2">
                    <h1
                        class="text-heading-page"
                        transition:name={`char-name-${id}`}
                    >
                        {safeName}
                    </h1>
                    <img
                        class="rounded-full bg-slate-100 p-1 dark:bg-slate-800"
                        src={safeElementIcon}
                        alt={safeElement}
                        width={28}
                        height={28}
                    />
                </div>

                <Stars quantity={safeRarity} />
            </header>

            <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                {statItems.map((item) => (
                    <div class={`flex flex-col items-center gap-1 ${statCardClass}`}>
                        <item.Icon size={20} class="text-slate-600 dark:text-slate-300" />
                        <span class={statLabelClass}>{item.label}</span>
                        <span class={statValueClass}>{item.value}</span>
                    </div>
                ))}
            </section>
        </article>
    </Content>
</Layout>
