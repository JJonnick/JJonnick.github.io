---
import Content from "@/layouts/Content.astro";
import Layout from "@/layouts/Layout.astro";
import Stars from "@/components/Stars.astro";
import LazyImage from "@/components/LazyImage.astro";
import { Gauge, Sparkles, Heart, Swords } from "@lucide/astro";
import { genshin } from "@/games";
import { toCharacterDetail } from "@/games/genshin/detail";
import { loadDataset } from "@/services/dataset-loader";
import type { Character } from "@/types";

interface Props {
    char: Character;
}

export function getStaticPaths() {
    const characters = loadDataset("genshin", "characters");

    return characters.map((char) => ({
        params: { id: String(char.id) },
        props: { char },
    }));
}

const detail = toCharacterDetail(Astro.props.char, genshin);
const { id, name, icon, element, elementIcon, rarity } = detail;
const STAT_ICONS = { level: Gauge, constellation: Sparkles, friendship: Heart, weapon: Swords };
const statItems = detail.stats.map((stat) => ({ ...stat, Icon: STAT_ICONS[stat.key] }));
const statCardClass = "surface-panel p-3";
const statLabelClass = "text-muted-body text-xs";
const statValueClass = "text-lg font-semibold text-slate-900 dark:text-slate-100";
---

<Layout title={name}>
    <link slot="head" rel="preload" as="image" href={icon} />
    <Content>
        <article class="mx-auto w-full max-w-4xl space-y-5">
            <header
                class="surface-panel flex flex-col items-center gap-3 p-5 text-center dark:text-slate-100"
            >
                <LazyImage
                    transitionName={`char-icon-${id}`}
                    class="rounded-full bg-slate-100 p-1 ring-1 ring-slate-300 dark:bg-slate-800 dark:ring-slate-700"
                    src={icon}
                    alt={`${name} avatar`}
                    width={120}
                    height={120}
                    loading="eager"
                />

                <div class="flex items-center gap-2">
                    <h1
                        class="text-heading-page"
                        transition:name={`char-name-${id}`}
                    >
                        {name}
                    </h1>
                    <img
                        class="rounded-full bg-slate-100 p-1 dark:bg-slate-800"
                        src={elementIcon}
                        alt={element}
                        width={28}
                        height={28}
                    />
                </div>

                <Stars quantity={rarity} />
            </header>

            <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                {statItems.map((item) => (
                    <div class={`flex flex-col items-center gap-1 ${statCardClass}`}>
                        <item.Icon size={20} class="text-slate-600 dark:text-slate-300" />
                        <span class={statLabelClass}>{item.label}</span>
                        <span class={statValueClass}>{item.value}</span>
                    </div>
                ))}
            </section>
        </article>
    </Content>
</Layout>
