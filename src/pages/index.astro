---
import Content from "@/layouts/Content.astro";
import Layout from "@/layouts/Layout.astro";
import Chests from "@/components/Chests.astro";
import Oculis from "@/components/Oculis.astro";
import { loadDataset } from "@/services/dataset-loader";
import StatsList, { type StatRow } from "@/components/StatsList.astro";
import { toSafeNumber } from "@/utils/numbers";

const account = loadDataset("genshin", "account");

const stats = account.stats;
const nickname = account.nickname?.trim() || "Viajero";
const level = toSafeNumber(account.level);

const chests = {
    common: toSafeNumber(stats?.common_chests),
    exquisite: toSafeNumber(stats?.exquisite_chests),
    precious: toSafeNumber(stats?.precious_chests),
    luxurious: toSafeNumber(stats?.luxurious_chests),
    remarkable: toSafeNumber(stats?.remarkable_chests),
};

const oculis = {
    anemo: toSafeNumber(stats?.anemoculi),
    geo: toSafeNumber(stats?.geoculi),
    electro: toSafeNumber(stats?.electroculi),
    dendro: toSafeNumber(stats?.dendroculi),
    hydro: toSafeNumber(stats?.hydroculi),
    pyro: toSafeNumber(stats?.pyroculi),
    luno: toSafeNumber(stats?.lunoculi),
};

const summaryRows: StatRow[] = [
    { icon: "User", value: nickname, label: "Jugador" },
    { icon: "Star", value: level, label: "Nivel" },
    { icon: "Calendar", value: toSafeNumber(stats.days_active), label: "Días activos" },
    { icon: "Award", value: toSafeNumber(stats.achievements), label: "Logros" },
    { icon: "Users", value: toSafeNumber(stats.characters), label: "Personajes" },
    { icon: "MapPin", value: toSafeNumber(stats.unlocked_waypoints), label: "Teletransportes" },
    { icon: "Map", value: toSafeNumber(stats.unlocked_domains), label: "Dominios" },
    { icon: "Shell", value: stats.spiral_abyss || "-", label: "Abismo" },
];
---

<Layout title="Estadísticas de Genshin Impact">
    <Content>
        <h1 class="text-heading-page wrap-break-word">
            {nickname}, este es tu progreso
        </h1>
        <p class="text-muted-body mt-2 max-w-2xl">
            Datos principales, cofres y oculus en una sola vista.
        </p>

        <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,19rem)_1fr]">
            <StatsList rows={summaryRows} />

            <section class="space-y-3">
                <h2 class="text-heading-section">Cofres</h2>
                <Chests {...chests} />
            </section>
        </div>

        <section class="mt-8 space-y-3">
            <h2 class="text-heading-section">Oculus</h2>
            <Oculis {...oculis} />
        </section>
    </Content>
</Layout>
