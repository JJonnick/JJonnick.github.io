---
import { ChevronDown, Orbit } from "@lucide/astro";

interface GameOption {
    id: string;
    label: string;
    href: string;
}

interface Props {
    currentGame: {
        id: string;
        label: string;
        shortLabel: string;
    };
    options: GameOption[];
}

const { currentGame, options } = Astro.props;
const popoverId = "game-switcher-popover";
const triggerId = "game-switcher-trigger";
---

<div class="relative">
    <button
        id={triggerId}
        type="button"
        popovertarget={popoverId}
        aria-controls={popoverId}
        aria-haspopup="true"
        class="ui-control ui-control-idle game-switcher-trigger flex items-center gap-2 whitespace-nowrap"
        aria-label="Seleccionar juego"
    >
        <Orbit size={17} aria-hidden="true" />
        <span class="hidden sm:inline">{currentGame.label}</span>
        <span class="sm:hidden">{currentGame.shortLabel}</span>
        <ChevronDown size={15} class="opacity-75" aria-hidden="true" />
    </button>

    <div
        id={popoverId}
        popover="auto"
        aria-label="Juegos disponibles"
        class="surface-panel game-switcher-popover fixed z-50 m-0 w-56 space-y-1 p-2 shadow-[0_10px_20px_-15px_rgba(15,23,42,0.55)]"
    >
        {
            options.map((option) => (
                <a
                    href={option.href}
                    class:list={[
                        "ui-control w-full justify-start",
                        option.id === currentGame.id
                            ? "ui-control-active"
                            : "ui-control-idle",
                    ]}
                    aria-current={option.id === currentGame.id ? "page" : undefined}
                >
                    {option.label}
                </a>
            ))
        }
    </div>
</div>

<style is:global>
    #game-switcher-trigger {
        anchor-name: --game-switcher-anchor;
    }

    #game-switcher-popover {
        position: fixed;
        inset: auto;
        position-anchor: --game-switcher-anchor;
        top: anchor(bottom);
        right: anchor(right);
        margin-top: 0.5rem;
        max-width: min(14rem, calc(100vw - 1rem));
        position-try-fallbacks:
            --game-switcher-below-left, --game-switcher-above-right,
            --game-switcher-above-left;
    }

    @position-try --game-switcher-below-left {
        top: anchor(bottom);
        right: auto;
        left: anchor(left);
        margin-top: 0.5rem;
    }

    @position-try --game-switcher-above-right {
        top: auto;
        right: anchor(right);
        bottom: anchor(top);
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    @position-try --game-switcher-above-left {
        top: auto;
        right: auto;
        bottom: anchor(top);
        left: anchor(left);
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    @supports not (top: anchor(bottom)) {
        #game-switcher-popover {
            top: 4rem;
            right: 1rem;
            left: auto;
        }
    }
</style>
