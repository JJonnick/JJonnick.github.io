---
import { ChevronDown } from "@lucide/astro";

interface GameOption {
    id: string;
    label: string;
    href: string;
}

interface Props {
    currentGame: {
        id: string;
        label: string;
        shortLabel: string;
    };
    options: GameOption[];
}

const { currentGame, options } = Astro.props;
const popoverId = "game-switcher-popover";
const triggerId = "game-switcher-trigger";
---

<div class="game-switcher relative">
    <button
        id={triggerId}
        type="button"
        popovertarget={popoverId}
        aria-controls={popoverId}
        aria-haspopup="true"
        class="ui-control ui-control-idle pr-2"
        aria-label={`Juego actual: ${currentGame.label}. Cambiar de juego`}
    >
        <span class="hidden sm:inline">{currentGame.label}</span>
        <span class="sm:hidden">{currentGame.shortLabel}</span>
        <ChevronDown
            size={14}
            class="game-switcher-chevron opacity-60"
            aria-hidden="true"
        />
    </button>

    <div
        id={popoverId}
        popover="auto"
        aria-label="Juegos disponibles"
        class="surface-panel m-0 w-52 space-y-0.5 rounded-xl p-1 shadow-lg shadow-slate-900/10 dark:shadow-black/40"
    >
        {
            options.map((option) => (
                <a
                    href={option.href}
                    class:list={[
                        "ui-control w-full justify-start",
                        option.id === currentGame.id
                            ? "ui-control-active"
                            : "ui-control-idle",
                    ]}
                    aria-current={option.id === currentGame.id ? "page" : undefined}
                >
                    {option.label}
                </a>
            ))
        }
    </div>
</div>

<style is:global>
    #game-switcher-trigger {
        anchor-name: --game-switcher-anchor;
    }

    .game-switcher-chevron {
        transition: rotate 200ms var(--ease-out-strong);
    }

    .game-switcher:has(#game-switcher-popover:popover-open)
        .game-switcher-chevron {
        rotate: 180deg;
    }

    #game-switcher-popover {
        position: fixed;
        inset: auto;
        position-anchor: --game-switcher-anchor;
        top: anchor(bottom);
        right: anchor(right);
        margin-top: 0.375rem;
        max-width: min(13rem, calc(100vw - 1rem));
        position-try-fallbacks:
            --game-switcher-below-left, --game-switcher-above-right,
            --game-switcher-above-left;

        /* Closed state doubles as the exit animation: shorter than the entry. */
        opacity: 0;
        transform: scale(0.97) translateY(-4px);
        transform-origin: top right;
        transition-property: opacity, transform, display, overlay;
        transition-duration: 120ms;
        transition-timing-function: var(--ease-out-strong);
        transition-behavior: allow-discrete;
    }

    #game-switcher-popover:popover-open {
        opacity: 1;
        transform: none;
        transition-duration: 180ms;

        @starting-style {
            opacity: 0;
            transform: scale(0.97) translateY(-4px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #game-switcher-popover,
        #game-switcher-popover:popover-open {
            transform: none;

            @starting-style {
                transform: none;
            }
        }

        .game-switcher-chevron {
            transition: none;
        }
    }

    @position-try --game-switcher-below-left {
        top: anchor(bottom);
        right: auto;
        left: anchor(left);
        margin-top: 0.375rem;
    }

    @position-try --game-switcher-above-right {
        top: auto;
        right: anchor(right);
        bottom: anchor(top);
        margin-top: 0;
        margin-bottom: 0.375rem;
    }

    @position-try --game-switcher-above-left {
        top: auto;
        right: auto;
        bottom: anchor(top);
        left: anchor(left);
        margin-top: 0;
        margin-bottom: 0.375rem;
    }

    @supports not (top: anchor(bottom)) {
        #game-switcher-popover {
            top: 3.75rem;
            right: 1rem;
            left: auto;
        }
    }
</style>
