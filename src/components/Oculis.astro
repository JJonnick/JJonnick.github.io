---
import { OCULUS_TOTALS, oculusProgress } from "@/games/genshin/oculi";
import Oculi from "./Oculi.astro";
import anemoculiImg from "@assets/oculis/anemoculus.webp";
import geoculiImg from "@assets/oculis/geoculus.webp";
import electroculiImg from "@assets/oculis/electroculus.webp";
import dendroculiImg from "@assets/oculis/dendroculus.webp";
import hydroculiImg from "@assets/oculis/hydroculus.webp";
import pyroculiImg from "@assets/oculis/pyroculus.webp";
import lunoculiImg from "@assets/oculis/lunoculus.webp";

interface Props {
    anemo: number;
    dendro: number;
    electro: number;
    geo: number;
    hydro: number;
    pyro: number;
    luno: number;
}

const { anemo, dendro, electro, geo, hydro, pyro, luno } = Astro.props;

const tiles = [
    { type: "anemo", quantity: anemo, image: anemoculiImg, label: "Anemoculus" },
    { type: "geo", quantity: geo, image: geoculiImg, label: "Geoculus" },
    { type: "electro", quantity: electro, image: electroculiImg, label: "Electroculus" },
    { type: "dendro", quantity: dendro, image: dendroculiImg, label: "Dendroculus" },
    { type: "hydro", quantity: hydro, image: hydroculiImg, label: "Hydroculus" },
    { type: "pyro", quantity: pyro, image: pyroculiImg, label: "Pyroculus" },
    { type: "luno", quantity: luno, image: lunoculiImg, label: "Lunoculus" },
] as const;
---

<div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-7">
    {
        tiles.map((tile) => (
            <Oculi
                quantity={tile.quantity}
                image={tile.image}
                label={tile.label}
                progress={oculusProgress(tile.quantity, OCULUS_TOTALS[tile.type])}
            />
        ))
    }
</div>
