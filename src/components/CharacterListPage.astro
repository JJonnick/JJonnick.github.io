---
import Layout from "@/layouts/Layout.astro";
import Content from "@/layouts/Content.astro";
import CardCharacter from "@/components/CardCharacter.astro";
import CharacterFilters from "@/components/CharacterFilters.astro";
import Pagination from "@/components/Pagination.astro";
import {
    CHARACTER_PAGE_SIZE,
    getCharacterListView,
    normalizeElement,
} from "@/services/character-list";
import type { CharacterSummary } from "@/types";
import type { ElementVisual } from "@/utils/elements";

interface Props {
    title: string;
    heading: string;
    description: string;
    emptyMessage: string;
    characters: CharacterSummary[];
    basePath: string;
    elements: readonly string[];
    elementLabels: Record<string, string>;
    elementVisuals?: Partial<Record<string, ElementVisual>>;
    showElementIcons?: boolean;
    imageWidth?: number;
    imageHeight?: number;
    imageAspectRatioClass?: string;
    imageClass?: string;
}

const {
    title,
    heading,
    description,
    emptyMessage,
    characters,
    basePath,
    elements,
    elementLabels,
    elementVisuals,
    showElementIcons = false,
    imageWidth,
    imageHeight,
    imageAspectRatioClass,
    imageClass,
} = Astro.props;

const view = getCharacterListView(characters, Astro.url, {
    basePath,
    pageSize: CHARACTER_PAGE_SIZE,
    elementOrder: elements,
});
const visibleCharacters = new Set(view.items);
---

<Layout title={title}>
    <Content>
        <h1 class="text-heading-page mb-1 text-xl">{heading}</h1>
        <p class="text-muted-body mb-5 max-w-2xl">{description}</p>

        {
            characters.length === 0 ? (
                <section class="surface-panel p-5 text-sm text-slate-700 dark:text-slate-200">
                    {emptyMessage}
                </section>
            ) : (
                <>
                    <CharacterFilters
                        {basePath}
                        filters={view.filters}
                        {elementLabels}
                        {elementVisuals}
                        {showElementIcons}
                    />

                    <div
                        id="character-grid"
                        class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 [content-visibility:auto] [contain-intrinsic-size:1px_1200px]"
                    >
                        {characters.map((item) => (
                            <div
                                data-filter-card
                                data-element={normalizeElement(item.element)}
                                data-rarity={item.rarity ?? ""}
                                hidden={!visibleCharacters.has(item)}
                            >
                                <CardCharacter
                                    href={`${basePath}/${item.id}`}
                                    char={item}
                                    elementVisuals={elementVisuals}
                                    imageWidth={imageWidth}
                                    imageHeight={imageHeight}
                                    imageAspectRatioClass={imageAspectRatioClass}
                                    imageClass={imageClass}
                                />
                            </div>
                        ))}
                    </div>

                    <p
                        id="no-results"
                        hidden={!view.isEmpty}
                        class="surface-panel p-5 text-center text-sm text-slate-600 dark:text-slate-300"
                        aria-live="polite"
                    >
                        No hay personajes que coincidan con los filtros
                        seleccionados.
                    </p>

                    <Pagination pagination={view.pagination} />
                </>
            )
        }
    </Content>
</Layout>
