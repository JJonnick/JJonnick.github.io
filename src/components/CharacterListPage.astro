---
import Layout from "@/layouts/Layout.astro";
import Content from "@/layouts/Content.astro";
import CardCharacter from "@/components/CardCharacter.astro";
import CharacterFilters from "@/components/CharacterFilters.astro";
import Pagination from "@/components/Pagination.astro";
import { CHARACTER_PAGE_SIZE } from "@/services/character-list";
import type { CharacterSummary } from "@/types";
import type { ElementVisual } from "@/utils/elements";

interface PaginationData {
    currentPage: number;
    lastPage: number;
    prevUrl?: string | undefined;
    nextUrl?: string | undefined;
}

interface Props {
    title: string;
    heading: string;
    description: string;
    emptyMessage: string;
    characters: CharacterSummary[];
    basePath: string;
    presentElements: string[];
    rarities: number[];
    elementLabels: Record<string, string>;
    elementVisuals?: Partial<Record<string, ElementVisual>>;
    showElementIcons?: boolean;
    imageWidth?: number;
    imageHeight?: number;
    imageAspectRatioClass?: string;
    imageClass?: string;
    pagination?: PaginationData;
}

const {
    title,
    heading,
    description,
    emptyMessage,
    characters,
    basePath,
    presentElements,
    rarities,
    elementLabels,
    elementVisuals,
    showElementIcons = false,
    imageWidth,
    imageHeight,
    imageAspectRatioClass,
    imageClass,
    pagination,
} = Astro.props;
---

<Layout title={title}>
    <Content>
        <h1 class="text-heading-page mb-1 text-xl">{heading}</h1>
        <p class="text-muted-body mb-5 max-w-2xl">{description}</p>

        {
            characters.length === 0 ? (
                <section class="surface-panel p-5 text-sm text-slate-700 dark:text-slate-200">
                    {emptyMessage}
                </section>
            ) : (
                <>
                    <CharacterFilters
                        {basePath}
                        {presentElements}
                        {rarities}
                        {elementLabels}
                        {elementVisuals}
                        {showElementIcons}
                    />

                    <div
                        id="character-grid"
                        class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 [content-visibility:auto] [contain-intrinsic-size:1px_1200px]"
                    >
                        {characters.map((item, index) => (
                            <div
                                data-filter-card
                                data-element={
                                    item.element?.trim().toLowerCase() ?? ""
                                }
                                data-rarity={item.rarity ?? ""}
                                hidden={
                                    pagination &&
                                    (index <
                                        (pagination.currentPage - 1) *
                                            CHARACTER_PAGE_SIZE ||
                                        index >=
                                            pagination.currentPage * CHARACTER_PAGE_SIZE)
                                }
                            >
                                <CardCharacter
                                    href={`${basePath}/${item.id}`}
                                    char={item}
                                    elementVisuals={elementVisuals}
                                    imageWidth={imageWidth}
                                    imageHeight={imageHeight}
                                    imageAspectRatioClass={imageAspectRatioClass}
                                    imageClass={imageClass}
                                />
                            </div>
                        ))}
                    </div>

                    <p
                        id="no-results"
                        hidden
                        class="surface-panel p-5 text-center text-sm text-slate-600 dark:text-slate-300"
                        aria-live="polite"
                    >
                        No hay personajes que coincidan con los filtros
                        seleccionados.
                    </p>

                    {pagination && (
                        <Pagination
                            currentPage={pagination.currentPage}
                            lastPage={pagination.lastPage}
                            prevUrl={pagination.prevUrl}
                            nextUrl={pagination.nextUrl}
                            basePath={basePath}
                        />
                    )}
                </>
            )
        }
    </Content>
</Layout>
