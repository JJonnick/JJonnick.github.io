---
import HeaderButton from "./HeaderButton.astro";
import GameSwitcher from "./GameSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { House, Moon, Sun, Users } from "@lucide/astro";
import { GAMES, getGameForPath, isInCharacterSection } from "@/games";

const pathname = Astro.url.pathname;
const currentGame = getGameForPath(pathname);
const isCharacters = isInCharacterSection(currentGame, pathname);

const homeHref = currentGame.homePath;
const charactersHref = currentGame.charactersPath;
const isHome = pathname === homeHref;

const gameOptions = GAMES.map((game) => ({
    id: game.id,
    label: game.label,
    href: isCharacters ? game.charactersPath : game.homePath,
}));
---

<header
    class="sticky top-0 z-40 border-b border-slate-900/5 bg-slate-100/75 backdrop-blur-lg dark:border-white/5 dark:bg-slate-950/75"
>
    <div class="mx-auto flex h-14 w-full max-w-6xl items-center gap-1 px-4">
        <a
            href={homeHref}
            class="mr-auto flex min-w-0 items-center gap-2 rounded-md text-[15px] font-semibold tracking-tight text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/80 dark:text-slate-100"
        >
            <span
                class="size-2 shrink-0 rounded-full bg-sky-500 dark:bg-sky-400"
                aria-hidden="true"></span>
            <span class="truncate">{currentGame.label}</span>
        </a>

        <nav class="flex items-center gap-0.5" aria-label="Navegación principal">
            <HeaderButton href={homeHref} isActive={isHome}>
                <House slot="before" size={16} aria-hidden="true" />
                Inicio
            </HeaderButton>
            <HeaderButton href={charactersHref} isActive={isCharacters}>
                <Users slot="before" size={16} aria-hidden="true" />
                Personajes
            </HeaderButton>
        </nav>

        <span
            class="mx-1 h-5 w-px shrink-0 bg-slate-900/10 dark:bg-white/10"
            aria-hidden="true"></span>

        <GameSwitcher {currentGame} options={gameOptions} />
        <ThemeToggle>
            <Sun slot="sun" size={16} aria-hidden="true" />
            <Moon slot="moon" size={16} aria-hidden="true" />
        </ThemeToggle>
    </div>
</header>
