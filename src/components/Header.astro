---
import HeaderButton from "./HeaderButton.astro";
import GameSwitcher from "./GameSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { House, Moon, Sun, Users } from "@lucide/astro";
import { GAMES, getGameForPath, isInCharacterSection } from "@/games";

const pathname = Astro.url.pathname;
const currentGame = getGameForPath(pathname);
const isCharacters = isInCharacterSection(currentGame, pathname);

const homeHref = currentGame.homePath;
const charactersHref = currentGame.charactersPath;
const isHome = pathname === homeHref;
const brandTitle = currentGame.label;
const brandDescription = currentGame.copy.tagline;

const gameOptions = GAMES.map((game) => ({
    id: game.id,
    label: game.label,
    href: isCharacters ? game.charactersPath : game.homePath,
}));
---

<header
    class="sticky top-0 z-40 border-b border-slate-200/80 bg-slate-50/92 dark:border-slate-800 dark:bg-slate-950/88"
>
    <div
        class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3"
    >
        <div class="min-w-0">
            <a
                href={homeHref}
                class="text-lg font-semibold text-slate-900 dark:text-slate-100"
            >
                {brandTitle}
            </a>
            <p
                class="hidden text-xs text-slate-600 dark:text-slate-300 sm:block"
            >
                {brandDescription}
            </p>
        </div>

        <nav
            class="flex w-full flex-wrap items-center gap-2 max-[400px]:gap-1.5 sm:w-auto"
            aria-label="Navegación principal"
        >
            <GameSwitcher {currentGame} options={gameOptions} />

            <HeaderButton href={homeHref} isActive={isHome}>
                <House slot="before" size={17} aria-hidden="true" />
                Inicio
            </HeaderButton>
            <HeaderButton href={charactersHref} isActive={isCharacters}>
                <Users slot="before" size={17} aria-hidden="true" />
                Personajes
            </HeaderButton>
            <ThemeToggle>
                <Sun slot="sun" size={18} aria-hidden="true" />
                <Moon slot="moon" size={18} aria-hidden="true" />
            </ThemeToggle>
        </nav>
    </div>
</header>
