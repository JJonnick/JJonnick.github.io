---
import { getVisiblePageNumbers } from "@/services/character-list";

interface Props {
    currentPage: number;
    lastPage: number;
    prevUrl?: string | undefined;
    nextUrl?: string | undefined;
    basePath: string;
}

const { currentPage, lastPage, prevUrl, nextUrl, basePath } = Astro.props;
const visiblePages = new Set(getVisiblePageNumbers(currentPage, lastPage));
const pageNumbers = Array.from({ length: lastPage }, (_, index) => index + 1);
const visiblePageList = [...visiblePages];
const showStartEllipsis = (visiblePageList[1] ?? 0) > 2;
const showEndEllipsis = (visiblePageList.at(-2) ?? lastPage) < lastPage - 1;

function pageUrl(page: number): string {
    return page === 1 ? basePath : `${basePath}/${page}`;
}
---

{
    lastPage > 1 && (
        <nav
            aria-label="Paginación"
            data-pagination-nav
            class="mt-6 flex flex-wrap items-center justify-center gap-2"
        >
            <a
                href={prevUrl ?? pageUrl(Math.max(1, currentPage - 1))}
                data-page-prev-link
                class="ui-control ui-control-idle"
                aria-label="Página anterior"
                hidden={!prevUrl}
            >
                ← Anterior
            </a>
            <span
                data-page-prev-disabled
                class="ui-control ui-control-idle cursor-not-allowed opacity-40"
                aria-disabled="true"
                hidden={Boolean(prevUrl)}
            >
                ← Anterior
            </span>

            <div class="flex items-center gap-1" data-page-links>
                {pageNumbers.map((p) => (
                    <>
                        {p === lastPage && (
                            <span
                                data-page-end-ellipsis
                                aria-hidden="true"
                                hidden={!showEndEllipsis}
                                class="px-1 text-slate-500 dark:text-slate-400"
                            >
                                …
                            </span>
                        )}
                        <a
                            href={pageUrl(p)}
                            data-page-number={String(p)}
                            class={`ui-control ${p === currentPage ? "ui-control-active" : "ui-control-idle"}`}
                            aria-current={p === currentPage ? "page" : undefined}
                            aria-label={`Página ${p}`}
                            hidden={!visiblePages.has(p)}
                        >
                            {p}
                        </a>
                        {p === 1 && (
                            <span
                                data-page-start-ellipsis
                                aria-hidden="true"
                                hidden={!showStartEllipsis}
                                class="px-1 text-slate-500 dark:text-slate-400"
                            >
                                …
                            </span>
                        )}
                    </>
                ))}
            </div>

            <a
                href={nextUrl ?? pageUrl(Math.min(lastPage, currentPage + 1))}
                data-page-next-link
                class="ui-control ui-control-idle"
                aria-label="Página siguiente"
                hidden={!nextUrl}
            >
                Siguiente →
            </a>
            <span
                data-page-next-disabled
                class="ui-control ui-control-idle cursor-not-allowed opacity-40"
                aria-disabled="true"
                hidden={Boolean(nextUrl)}
            >
                Siguiente →
            </span>
        </nav>
    )
}
