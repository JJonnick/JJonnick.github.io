---
import type { CharacterListPagination } from "@/services/character-list";

interface Props {
    pagination: CharacterListPagination;
}

const { pagination } = Astro.props;
const { links, prev, next, totalPages } = pagination;
---

{
    totalPages > 1 && (
        <nav
            aria-label="Paginación"
            data-pagination-nav
            hidden={pagination.isHidden}
            class="mt-6 flex flex-wrap items-center justify-center gap-2"
        >
            <a
                href={prev.href}
                data-page-prev-link
                class="ui-control ui-control-idle"
                aria-label="Página anterior"
                hidden={prev.isDisabled}
            >
                ← Anterior
            </a>
            <span
                data-page-prev-disabled
                class="ui-control ui-control-idle cursor-not-allowed opacity-40"
                aria-disabled="true"
                hidden={!prev.isDisabled}
            >
                ← Anterior
            </span>

            <div class="flex items-center gap-1" data-page-links>
                {links.map((link) => (
                    <>
                        {link.page === totalPages && (
                            <span
                                data-page-end-ellipsis
                                aria-hidden="true"
                                hidden={!pagination.showEndEllipsis}
                                class="px-1 text-slate-500 dark:text-slate-400"
                            >
                                …
                            </span>
                        )}
                        <a
                            href={link.href}
                            data-page-number={String(link.page)}
                            class={`ui-control ${link.isCurrent ? "ui-control-active" : "ui-control-idle"}`}
                            aria-current={link.isCurrent ? "page" : undefined}
                            aria-label={`Página ${link.page}`}
                            hidden={!link.isVisible}
                        >
                            {link.page}
                        </a>
                        {link.page === 1 && (
                            <span
                                data-page-start-ellipsis
                                aria-hidden="true"
                                hidden={!pagination.showStartEllipsis}
                                class="px-1 text-slate-500 dark:text-slate-400"
                            >
                                …
                            </span>
                        )}
                    </>
                ))}
            </div>

            <a
                href={next.href}
                data-page-next-link
                class="ui-control ui-control-idle"
                aria-label="Página siguiente"
                hidden={next.isDisabled}
            >
                Siguiente →
            </a>
            <span
                data-page-next-disabled
                class="ui-control ui-control-idle cursor-not-allowed opacity-40"
                aria-disabled="true"
                hidden={!next.isDisabled}
            >
                Siguiente →
            </span>
        </nav>
    )
}
