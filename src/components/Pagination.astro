---
interface Props {
    currentPage: number;
    lastPage: number;
    prevUrl?: string | undefined;
    nextUrl?: string | undefined;
    basePath: string;
}

const { currentPage, lastPage, prevUrl, nextUrl, basePath } = Astro.props;

function pageUrl(page: number): string {
    return page === 1 ? basePath : `${basePath}/${page}`;
}
---

{
    lastPage > 1 && (
        <nav
            aria-label="Paginación"
            data-pagination-nav
            class="mt-6 flex flex-wrap items-center justify-center gap-2"
        >
            {prevUrl ? (
                <a
                    href={prevUrl}
                    data-page-link
                    data-page-href={prevUrl}
                    data-page-prev
                    class="ui-control ui-control-idle"
                    aria-label="Página anterior"
                >
                    ← Anterior
                </a>
            ) : (
                <span
                    data-page-prev
                    class="ui-control ui-control-idle cursor-not-allowed opacity-40"
                    aria-disabled="true"
                >
                    ← Anterior
                </span>
            )}

            <div class="flex items-center gap-1">
                {Array.from({ length: lastPage }, (_, i) => i + 1).map(
                    (p) => (
                        <a
                            href={pageUrl(p)}
                            data-page-link
                            data-page-href={pageUrl(p)}
                            data-page-number={String(p)}
                            class={`ui-control ${p === currentPage ? "ui-control-active" : "ui-control-idle"}`}
                            aria-current={p === currentPage ? "page" : undefined}
                            aria-label={`Página ${p}`}
                        >
                            {p}
                        </a>
                    ),
                )}
            </div>

            {nextUrl ? (
                <a
                    href={nextUrl}
                    data-page-link
                    data-page-href={nextUrl}
                    data-page-next
                    class="ui-control ui-control-idle"
                    aria-label="Página siguiente"
                >
                    Siguiente →
                </a>
            ) : (
                <span
                    data-page-next
                    class="ui-control ui-control-idle cursor-not-allowed opacity-40"
                    aria-disabled="true"
                >
                    Siguiente →
                </span>
            )}
        </nav>
    )
}

<script>
    const syncPaginationLinks = () => {
        const search = window.location.search;
        const links = document.querySelectorAll<HTMLElement>('[data-page-link]');

        links.forEach((link) => {
            const targetHref = link.dataset.pageHref ?? link.getAttribute('href') ?? '';
            if (!targetHref) return;

            const targetUrl = new URL(targetHref, window.location.origin);
            targetUrl.search = search ? new URLSearchParams(search).toString() : '';
            link.setAttribute('href', `${targetUrl.pathname}${targetUrl.search}`);
        });
    };

    document.addEventListener('astro:page-load', syncPaginationLinks);
    syncPaginationLinks();
</script>
