---
interface Props {
    id?: string;
}

const { id = "theme-toggle" } = Astro.props;
---

<div class="flex items-center">
    <label
        for={id}
        class="ui-control ui-control-idle cursor-pointer focus-within:outline-none focus-within:ring-2 focus-within:ring-sky-400/80 focus-within:ring-offset-2 focus-within:ring-offset-slate-100 dark:focus-within:ring-offset-slate-950"
    >
        <input
            id={id}
            type="checkbox"
            role="switch"
            class="peer sr-only"
            data-theme-toggle
            aria-label="Cambiar entre tema claro y oscuro"
        />
        <span class="peer-checked:hidden"><slot name="moon" /></span>
        <span class="hidden peer-checked:inline-flex"><slot name="sun" /></span>
        <span class="hidden sm:inline">Tema</span>
    </label>
</div>

<script>
    import { initThemeToggle } from "@/scripts/theme-toggle";

    const runtimeWindow = window as Window & {
        __themeToggleCleanup?: () => void;
    };

    const initializeThemeToggle = () => {
        runtimeWindow.__themeToggleCleanup?.();
        runtimeWindow.__themeToggleCleanup = initThemeToggle(document, localStorage);
    };

    document.addEventListener("astro:page-load", initializeThemeToggle);
    initializeThemeToggle();
</script>
