---
import { CHARACTER_PAGE_SIZE, type CharacterListFilters } from "@/services/character-list";
import type { ElementVisual } from "@/utils/elements";

interface Props {
    basePath: string;
    filters: CharacterListFilters;
    elementLabels: Record<string, string>;
    elementVisuals?: Partial<Record<string, ElementVisual>>;
    showElementIcons?: boolean;
}

const {
    basePath,
    filters,
    elementLabels,
    elementVisuals,
    showElementIcons = false,
} = Astro.props;
const { elementOptions, rarityOptions } = filters;

const controlClass = (isActive: boolean) =>
    `ui-control ${isActive ? "ui-control-active" : "ui-control-idle"}`;

const getElementIconSrc = (element: string): string => {
    const iconPath = elementVisuals?.[element]?.iconPath;
    if (!iconPath) return `/elements/${element}.svg`;
    return typeof iconPath === "string" ? iconPath : iconPath.src;
};
---

<div
    id="character-filters"
    data-base-path={basePath}
    data-page-size={CHARACTER_PAGE_SIZE}
    class="mb-5 flex flex-wrap gap-4"
>
    {
        elementOptions.length > 1 && (
            <div
                class="flex flex-wrap items-center gap-1.5"
                role="group"
                aria-label="Filtrar por elemento"
            >
                <button
                    type="button"
                    data-filter-element="all"
                    class={controlClass(filters.element === "all")}
                    aria-pressed={filters.element === "all"}
                    aria-controls="character-grid"
                >
                    Todos
                </button>
                {elementOptions.map((element) => (
                    <button
                        type="button"
                        data-filter-element={element}
                        class={controlClass(filters.element === element)}
                        aria-pressed={filters.element === element}
                        aria-controls="character-grid"
                        aria-label={`Filtrar por elemento: ${elementLabels[element] ?? element}`}
                    >
                        {showElementIcons && (
                            <img
                                src={getElementIconSrc(element)}
                                alt=""
                                aria-hidden="true"
                                width={16}
                                height={16}
                                class="shrink-0"
                            />
                        )}
                        <span>{elementLabels[element] ?? element}</span>
                    </button>
                ))}
            </div>
        )
    }
    {
        rarityOptions.length > 1 && (
            <div
                class="flex flex-wrap items-center gap-1.5"
                role="group"
                aria-label="Filtrar por rareza"
            >
                <button
                    type="button"
                    data-filter-rarity="all"
                    class={controlClass(filters.rarity === "all")}
                    aria-pressed={filters.rarity === "all"}
                    aria-controls="character-grid"
                >
                    Todas
                </button>
                {rarityOptions.map((rarity) => (
                    <button
                        type="button"
                        data-filter-rarity={rarity}
                        class={controlClass(filters.rarity === rarity)}
                        aria-pressed={filters.rarity === rarity}
                        aria-controls="character-grid"
                        aria-label={`Filtrar por rareza: ${rarity} estrellas`}
                    >
                        {rarity}★
                    </button>
                ))}
            </div>
        )
    }
</div>

<script>
    import "@/scripts/character-filters";
</script>
