---
import { CHARACTER_PAGE_SIZE, type CharacterListFilters } from "@/services/character-list";
import type { Game } from "@/games";
import { getElementIconSrc } from "@/games/game";
import { ariaKeyShortcuts } from "@/scripts/shortcut-map";
import { X } from "@lucide/astro";
import Kbd from "./Kbd.astro";

interface Props {
    game: Game;
    filters: CharacterListFilters;
}

const { game, filters } = Astro.props;
const { elementOptions, rarityOptions } = filters;
const elementLabels: Record<string, string> = game.elementLabels;

const controlClass = (isActive: boolean) =>
    `ui-control ${isActive ? "ui-control-active" : "ui-control-idle"}`;
---

<div
    id="character-filters"
    data-base-path={game.charactersPath}
    data-page-size={CHARACTER_PAGE_SIZE}
    class="mb-5 flex flex-wrap gap-2"
>
    <form role="search" class="relative w-full sm:w-60" onsubmit="return false">
        <label class="sr-only" for="character-search">Buscar personaje por nombre</label>
        <input
            id="character-search"
            type="search"
            name="q"
            value={filters.query}
            placeholder="Buscar personaje"
            autocomplete="off"
            aria-controls="character-grid"
            aria-keyshortcuts={ariaKeyShortcuts("search")}
            data-filter-search
            class="character-search h-10 w-full rounded-xl border border-slate-200 bg-white pr-16 pl-3 text-sm text-slate-900 placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/80 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-400"
        />
        <Kbd
            shortcut="search"
            class="pointer-events-none absolute top-1/2 right-2.5 -translate-y-1/2 max-sm:hidden! pointer-coarse:hidden!"
            data-search-hint
        />
        <button
            type="button"
            data-filter-clear
            aria-label="Borrar búsqueda"
            hidden={filters.query === ""}
            class="ui-control ui-control-idle absolute top-1/2 right-1 size-8 -translate-y-1/2 justify-center px-0"
        >
            <X size={14} aria-hidden="true" />
        </button>
    </form>
    {
        elementOptions.length > 1 && (
            <div
                class="ui-segmented"
                data-arrow-nav
                role="group"
                aria-label="Filtrar por elemento"
            >
                <button
                    type="button"
                    data-filter-element="all"
                    class={controlClass(filters.element === "all")}
                    aria-pressed={filters.element === "all"}
                    aria-controls="character-grid"
                >
                    Todos
                </button>
                {elementOptions.map((element) => (
                    <button
                        type="button"
                        data-filter-element={element}
                        class={controlClass(filters.element === element)}
                        aria-pressed={filters.element === element}
                        aria-controls="character-grid"
                        aria-label={`Filtrar por elemento: ${elementLabels[element] ?? element}`}
                    >
                        {getElementIconSrc(game, element) && (
                            <img
                                src={getElementIconSrc(game, element)}
                                alt=""
                                aria-hidden="true"
                                width={16}
                                height={16}
                                class="shrink-0"
                            />
                        )}
                        <span>{elementLabels[element] ?? element}</span>
                    </button>
                ))}
            </div>
        )
    }
    {
        rarityOptions.length > 1 && (
            <div
                class="ui-segmented"
                data-arrow-nav
                role="group"
                aria-label="Filtrar por rareza"
            >
                <button
                    type="button"
                    data-filter-rarity="all"
                    class={controlClass(filters.rarity === "all")}
                    aria-pressed={filters.rarity === "all"}
                    aria-controls="character-grid"
                >
                    Todas
                </button>
                {rarityOptions.map((rarity) => (
                    <button
                        type="button"
                        data-filter-rarity={rarity}
                        class={controlClass(filters.rarity === rarity)}
                        aria-pressed={filters.rarity === rarity}
                        aria-controls="character-grid"
                        aria-label={`Filtrar por rareza: ${rarity} estrellas`}
                    >
                        {rarity}★
                    </button>
                ))}
            </div>
        )
    }
</div>

<script>
    import "@/scripts/character-filters";
</script>
