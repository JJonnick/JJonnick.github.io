---
interface Props {
    src: string;
    alt: string;
    width: number;
    height: number;
    aspectRatioClass?: string;
    class?: string;
    transitionName?: string;
    loading?: "lazy" | "eager";
}

const {
    src,
    alt,
    width,
    height,
    aspectRatioClass = "aspect-square",
    class: className,
    transitionName,
    loading = "lazy",
} = Astro.props;
---

<astro-lazy-image
  data-state="loading"
  class:list={["relative inline-block", aspectRatioClass]}
  style={`width:${width}px`}
>
  <img
    data-lazy-image-source
    src={src}
    alt={alt}
    width={width}
    height={height}
    class:list={[
      className,
      "h-full w-full object-contain [content-visibility:auto]",
      "opacity-0 transition-opacity duration-200",
    ]}
    transition:name={transitionName}
    loading={loading}
    decoding="async"
  />
  <span
    data-lazy-image-skeleton
    aria-hidden="true"
    class:list={[
      className,
      "absolute inset-0 animate-pulse pointer-events-none bg-slate-200 dark:bg-slate-700",
    ]}></span>
  <span
    data-lazy-image-error
    hidden
    role="img"
    aria-label={alt ? `No se pudo cargar la imagen: ${alt}` : "No se pudo cargar la imagen"}
    class:list={[
      className,
      "absolute inset-0 grid place-items-center bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400",
    ]}
  >
    <span aria-hidden="true" class="text-lg font-semibold">?</span>
  </span>
</astro-lazy-image>

<script>
  import { initializeLazyImage } from "@/scripts/lazy-image";

  class AstroLazyImage extends HTMLElement {
    cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      this.cleanup = initializeLazyImage(this);
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get("astro-lazy-image")) {
    customElements.define("astro-lazy-image", AstroLazyImage);
  }
</script>
