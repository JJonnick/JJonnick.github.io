---
import { Image } from "astro:assets";
import LazyImage from "./LazyImage.astro";
import type { CharacterSummary } from "@/types";
import { normalizeElement } from "@/services/character-list";
import type { Game } from "@/games";

interface Props {
    game: Game;
    char: CharacterSummary;
}

const { game, char } = Astro.props;
const href = `${game.charactersPath}/${char.id}`;
const {
    width: imageWidth,
    height: imageHeight,
    aspectClass: imageAspectRatioClass,
    imageClass,
} = game.portrait;
const elementVisual = game.elementVisuals[normalizeElement(char.element)];
---

<a
  href={href}
  class="surface-card-interactive group flex flex-col items-center justify-center p-5"
>
  <div class="flex flex-col items-center gap-4">
    <div class="relative inline-block">
      <LazyImage
        transitionName={`char-icon-${char.id}`}
        class={imageClass}
        src={char.icon}
        alt=""
        width={imageWidth}
        height={imageHeight}
        aspectRatioClass={imageAspectRatioClass}
      />
      {
        elementVisual && (
          typeof elementVisual.iconPath === "string" ? (
            <img
              src={elementVisual.iconPath}
              alt=""
              aria-hidden="true"
              width={22}
              height={22}
              style={`background: ${elementVisual.badgeBg}`}
              class="absolute -right-1.5 -bottom-1.5 rounded-full border border-white/60 p-0.5 dark:border-slate-900/60"
            />
          ) : (
            <Image
              src={elementVisual.iconPath}
              alt=""
              aria-hidden="true"
              width={22}
              height={22}
              class="absolute -right-1.5 -bottom-1.5 rounded-full border border-white/60 p-0.5 dark:border-slate-900/60"
              style={`background: ${elementVisual.badgeBg}`}
            />
          )
        )
      }
    </div>
    <h3
      class="max-w-full wrap-break-word text-center text-lg font-semibold leading-snug text-slate-900 dark:text-slate-100"
      transition:name={`char-name-${char.id}`}
    >
      {char.name}
    </h3>
  </div>
</a>
