---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import { getGameForPath } from "@/games";
import "@/styles/global.css";
interface Props {
    title: string;
}

const { title } = Astro.props;
const description = getGameForPath(Astro.url.pathname).copy.tagline;
---

<!doctype html>
<html lang="es" class="font-sans tabular-nums">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="dns-prefetch" href="https://enka.network" />
		<link rel="preconnect" href="https://enka.network" crossorigin />
		<title>{title}</title>
		<Font cssVariable="--font-quicksand" preload />
		<ClientRouter />
		<script is:inline data-astro-rerun="true">
			(function () {
				try {
					var theme = localStorage.getItem("theme");
					var isDark = false;

					if (theme === "dark") {
						isDark = true;
					} else if (theme === "light") {
						isDark = false;
					} else {
						// No saved preference, check system preference
						isDark = window.matchMedia(
							"(prefers-color-scheme: dark)",
						).matches;
					}

					if (isDark) {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
				} catch (_) {
					// Fallback when localStorage is not available: respect system preference
					var prefersDark = false;
					try {
						if (window.matchMedia) {
							prefersDark = window.matchMedia(
								"(prefers-color-scheme: dark)",
							).matches;
						}
					} catch (_e) {
						// If matchMedia is unavailable or throws, keep default
					}

					if (prefersDark) {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
				}
			})();
		</script>
		<slot name="head" />
	</head>
	<body class="relative bg-slate-100 dark:bg-slate-950 min-h-dvh">
		<Header />
		<main transition:name="page">
			<slot />
		</main>
		<style is:global>
			:root {
				--accent: 3, 105, 161;
				--accent-light: 56, 189, 248;
				--accent-dark: 8, 30, 51;
				--accent-gradient: linear-gradient(
					45deg,
					rgb(var(--accent)),
					rgb(var(--accent-light)) 30%,
					rgb(224 242 254) 60%
				);
			}
			code {
				font-family:
					Menlo,
					Monaco,
					Lucida Console,
					Liberation Mono,
					DejaVu Sans Mono,
					Bitstream Vera Sans Mono,
					Courier New,
					monospace;
			}
			/* Page changes happen often: keep them short, exit faster than enter. */
			::view-transition-old(page),
			::view-transition-new(page) {
				animation-timing-function: var(--ease-out-strong);
			}
			::view-transition-old(page) {
				animation-name: page-out;
				animation-duration: 140ms;
			}
			::view-transition-new(page) {
				animation-name: page-in;
				animation-duration: 220ms;
			}
			::view-transition-group(*) {
				animation-duration: 240ms;
				animation-timing-function: var(--ease-out-strong);
			}
			@keyframes page-out {
				from {
					opacity: 1;
					transform: translateY(0);
				}
				to {
					opacity: 0;
					transform: translateY(-4px);
				}
			}
			@keyframes page-in {
				from {
					opacity: 0;
					transform: translateY(8px) scale(0.995);
				}
				to {
					opacity: 1;
					transform: translateY(0) scale(1);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				::view-transition-old(page),
				::view-transition-new(page) {
					animation-name: none;
					transform: none;
					filter: none;
				}
				::view-transition-group(*) {
					animation-name: none;
				}
			}
		</style>
	</body>
</html>
