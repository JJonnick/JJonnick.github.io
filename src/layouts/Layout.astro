---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import ShortcutsHelp from "@/components/ShortcutsHelp.astro";
import { getGameForPath } from "@/games";
import "@/styles/global.css";
interface Props {
    title: string;
}

const { title } = Astro.props;
const description = getGameForPath(Astro.url.pathname).copy.tagline;
---

<!doctype html>
<html lang="es" class="font-sans tabular-nums">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="dns-prefetch" href="https://enka.network" />
		<link rel="preconnect" href="https://enka.network" crossorigin />
		<title>{title}</title>
		<Font cssVariable="--font-quicksand" preload />
		<ClientRouter />
		<script is:inline data-astro-rerun="true">
			(function () {
				try {
					var theme = localStorage.getItem("theme");
					var isDark = false;

					if (theme === "dark") {
						isDark = true;
					} else if (theme === "light") {
						isDark = false;
					} else {
						// No saved preference, check system preference
						isDark = window.matchMedia(
							"(prefers-color-scheme: dark)",
						).matches;
					}

					if (isDark) {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
				} catch (_) {
					// Fallback when localStorage is not available: respect system preference
					var prefersDark = false;
					try {
						if (window.matchMedia) {
							prefersDark = window.matchMedia(
								"(prefers-color-scheme: dark)",
							).matches;
						}
					} catch (_e) {
						// If matchMedia is unavailable or throws, keep default
					}

					if (prefersDark) {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
				}
			})();
		</script>
		<slot name="head" />
	</head>
	<body class="relative bg-slate-100 dark:bg-slate-950 min-h-dvh">
		<a
			href="#main-content"
			class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-50 focus-visible:rounded-lg focus-visible:bg-white focus-visible:px-4 focus-visible:py-2 focus-visible:text-sm focus-visible:font-medium focus-visible:text-slate-900 focus-visible:ring-2 focus-visible:ring-sky-400/80 focus-visible:outline-none dark:focus-visible:bg-slate-900 dark:focus-visible:text-slate-100"
		>
			Saltar al contenido
		</a>
		<Header />
		<main id="main-content" tabindex="-1" class="focus:outline-none" transition:name="page">
			<slot />
		</main>
		<ShortcutsHelp />
		<style is:global>
			:root {
				--accent: 3, 105, 161;
				--accent-light: 56, 189, 248;
				--accent-dark: 8, 30, 51;
				--accent-gradient: linear-gradient(
					45deg,
					rgb(var(--accent)),
					rgb(var(--accent-light)) 30%,
					rgb(224 242 254) 60%
				);
			}
			code {
				font-family:
					Menlo,
					Monaco,
					Lucida Console,
					Liberation Mono,
					DejaVu Sans Mono,
					Bitstream Vera Sans Mono,
					Courier New,
					monospace;
			}
			/*
			 * Page changes happen often: keep them short. The UA blends old and new with
			 * plus-lighter, so both sides must share duration and curve: their opacities then sum
			 * to 1 and the content never dips mid-transition.
			 */
			::view-transition-old(page),
			::view-transition-new(page) {
				animation-duration: 180ms;
				animation-timing-function: var(--ease-out-strong);
			}
			::view-transition-old(page) {
				animation-name: page-out;
			}
			::view-transition-new(page) {
				animation-name: page-in;
			}
			::view-transition-group(*) {
				animation-duration: 240ms;
				animation-timing-function: var(--ease-out-strong);
			}
			@keyframes page-out {
				from {
					opacity: 1;
				}
				to {
					opacity: 0;
				}
			}
			@keyframes page-in {
				from {
					opacity: 0;
					transform: translateY(6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			/* Reduced motion drops movement, not feedback: keep a plain crossfade so nothing cuts. */
			@media (prefers-reduced-motion: reduce) {
				::view-transition-old(page),
				::view-transition-new(page) {
					animation-duration: 150ms;
					animation-timing-function: ease;
				}
				::view-transition-old(page) {
					animation-name: page-out;
				}
				::view-transition-new(page) {
					animation-name: page-fade-in;
				}
				::view-transition-group(*) {
					animation-name: none;
				}
				@keyframes page-fade-in {
					from {
						opacity: 0;
					}
					to {
						opacity: 1;
					}
				}
			}
		</style>
		<script>
			import "@/scripts/keyboard-init";
			import "@/scripts/theme-persist";
		</script>
	</body>
</html>
